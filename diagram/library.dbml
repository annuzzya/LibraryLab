Project library_system {
  database_type: 'PostgreSQL'
  Note: '''
    # Система управління бібліотекою з додатковими послугами
    Схема `library`, PostgreSQL 16
  '''
}

Enum copy_status {
  available
  on_loan
  reserved
  in_repair
  lost
  written_off
}

Enum fine_status {
  unpaid
  paid
  waived
}

Enum loan_status {
  active
  returned
  overdue
  lost
}

Enum order_status {
  new
  in_progress
  completed
  cancelled
}

Enum payment_method {
  cash
  card
  online
}

Enum reservation_status {
  pending
  ready
  fulfilled
  cancelled
  expired
}

Table roles [note: 'Ролі працівників'] {
  role_id smallint [pk, increment]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  description text
}

Table staff [note: 'Працівники бібліотеки (користувачі системи)'] {
  staff_id integer [pk, increment]
  role_id smallint [not null]
  branch_id integer
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  email varchar(120) [not null, unique]
  login varchar(50) [not null, unique]
  hired_at date [not null, default: `CURRENT_DATE`]
  is_active boolean [not null, default: true]
  Indexes {
    role_id [type: btree, name: "ix_staff_role", note: 'BTREE']
  }
}

Table branches [note: 'Філії бібліотеки'] {
  branch_id integer [pk, increment]
  name varchar(150) [not null, unique]
  address varchar(255) [not null]
  phone varchar(20)
  opens_at time [not null, default: '09:00:00']
  closes_at time [not null, default: '19:00:00']
}

Table members [note: 'Читачі. Soft delete + аудит змін'] {
  member_id integer [pk, increment]
  card_number varchar(20) [not null, unique]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  birth_date date
  email varchar(120) [not null]
  phone varchar(20)
  address varchar(255)
  registered_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'Хто створив запис']
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  is_deleted boolean [not null, default: false, note: 'Soft delete']
  deleted_at timestamptz [note: 'Soft delete: дата видалення']
  deleted_by integer [note: 'Soft delete: хто видалив']
  Indexes {
    (last_name, first_name) [type: btree, name: "ix_members_name", note: 'BTREE WHERE (NOT is_deleted)']
    phone [type: hash, name: "ix_members_phone_hash", note: 'HASH']
    `lower(email::text)` [unique, type: btree, name: "ux_members_email_active", note: 'BTREE WHERE (NOT is_deleted)']
  }
}

Table membership_plans [note: 'Тарифні плани абонементів. Аудит змін'] {
  plan_id integer [pk, increment]
  name varchar(80) [not null, unique]
  max_loans smallint [not null]
  loan_days smallint [not null]
  daily_fine "numeric(8,2)" [not null]
  monthly_price "numeric(10,2)" [not null]
  service_discount "numeric(5,2)" [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
}

Table memberships [note: 'Придбані абонементи (EXCLUDE: періоди не перетинаються)'] {
  membership_id integer [pk, increment]
  member_id integer [not null]
  plan_id integer [not null]
  start_date date [not null]
  end_date date [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table books [note: 'Книги каталогу. Soft delete + аудит змін, повнотекстовий пошук'] {
  book_id integer [pk, increment]
  isbn varchar(17) [not null]
  title varchar(255) [not null]
  publisher_id integer
  publish_year smallint
  language varchar(30) [not null, default: 'uk']
  pages integer
  description text
  search_vector tsvector [default: `(setweight(to_tsvector('simple'`, note: 'GENERATED ALWAYS AS ... STORED']
  created_at timestamptz [not null, default: `now()`]
  created_by integer [note: 'Хто створив запис']
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  is_deleted boolean [not null, default: false, note: 'Soft delete']
  deleted_at timestamptz [note: 'Soft delete: дата видалення']
  deleted_by integer [note: 'Soft delete: хто видалив']
  Indexes {
    publisher_id [type: btree, name: "ix_books_publisher", note: 'BTREE']
    search_vector [name: "ix_books_search", note: 'GIN']
    title [name: "ix_books_title_trgm", note: 'GIN']
    isbn [unique, type: btree, name: "ux_books_isbn_active", note: 'BTREE WHERE (NOT is_deleted)']
  }
}

Table authors [note: 'Автори. Soft delete'] {
  author_id integer [pk, increment]
  first_name varchar(60) [not null]
  last_name varchar(60) [not null]
  birth_year smallint
  country varchar(60)
  biography text
  is_deleted boolean [not null, default: false, note: 'Soft delete']
  deleted_at timestamptz [note: 'Soft delete: дата видалення']
  deleted_by integer [note: 'Soft delete: хто видалив']
  Indexes {
    last_name [name: "ix_authors_last_name_trgm", note: 'GIN']
  }
}

Table publishers [note: 'Видавництва'] {
  publisher_id integer [pk, increment]
  name varchar(150) [not null, unique]
  city varchar(80)
  website varchar(200)
}

Table genres [note: 'Жанри (ієрархія)'] {
  genre_id integer [pk, increment]
  name varchar(80) [not null, unique]
  parent_genre_id integer
}

Table book_authors [note: 'Зв\'язок M:N книга-автор'] {
  book_id integer
  author_id integer
  author_order smallint [not null, default: 1]
  Indexes {
    (book_id, author_id) [pk]
    author_id [type: btree, name: "ix_book_authors_author", note: 'BTREE']
  }
}

Table book_genres [note: 'Зв\'язок M:N книга-жанр'] {
  book_id integer
  genre_id integer
  Indexes {
    (book_id, genre_id) [pk]
    genre_id [type: btree, name: "ix_book_genres_genre", note: 'BTREE']
  }
}

Table book_copies [note: 'Фізичні примірники книг у філіях. Soft delete + аудит'] {
  copy_id integer [pk, increment]
  book_id integer [not null]
  branch_id integer [not null]
  inventory_code varchar(30) [not null, unique]
  status copy_status [not null, default: 'available']
  shelf varchar(20)
  acquired_at date [not null, default: `CURRENT_DATE`]
  price "numeric(10,2)"
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  is_deleted boolean [not null, default: false, note: 'Soft delete']
  deleted_at timestamptz [note: 'Soft delete: дата видалення']
  deleted_by integer [note: 'Soft delete: хто видалив']
  Indexes {
    (book_id, branch_id, status) [type: btree, name: "ix_copies_book_branch_status", note: 'BTREE WHERE (NOT is_deleted)']
  }
}

Table book_reviews [note: 'Відгуки читачів. Soft delete'] {
  review_id integer [pk, increment]
  book_id integer [not null]
  member_id integer [not null]
  rating smallint [not null]
  comment text
  created_at timestamptz [not null, default: `now()`]
  is_deleted boolean [not null, default: false, note: 'Soft delete']
  deleted_at timestamptz [note: 'Soft delete: дата видалення']
  deleted_by integer [note: 'Soft delete: хто видалив']
}

Table loans [note: 'Видачі книг. Аудит змін'] {
  loan_id integer [pk, increment]
  copy_id integer [not null]
  member_id integer [not null]
  issued_by integer [not null]
  loan_date timestamptz [not null, default: `now()`]
  due_date date [not null]
  return_date timestamptz
  received_by integer
  extensions smallint [not null, default: 0]
  status loan_status [not null, default: 'active']
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  Indexes {
    copy_id [type: btree, name: "ix_loans_copy", note: 'BTREE']
    due_date [type: btree, name: "ix_loans_due_date", note: 'BTREE WHERE (return_date IS NULL)']
    loan_date [name: "ix_loans_loan_date_brin", note: 'BRIN']
    member_id [type: btree, name: "ix_loans_member_active", note: 'BTREE WHERE (return_date IS NULL)']
    copy_id [unique, type: btree, name: "ux_loans_copy_open", note: 'BTREE WHERE (return_date IS NULL)']
  }
}

Table reservations [note: 'Бронювання книг'] {
  reservation_id integer [pk, increment]
  book_id integer [not null]
  member_id integer [not null]
  branch_id integer [not null]
  reserved_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null, default: `(now() + '7 days'`]
  status reservation_status [not null, default: 'pending']
  Indexes {
    (book_id, status, reserved_at) [type: btree, name: "ix_reservations_book_status", note: 'BTREE']
    (book_id, member_id) [unique, type: btree, name: "ux_reservations_open", note: 'BTREE WHERE (status = ANY (ARRAY["pending"::reservation_status, "ready"::reservation_status]))']
  }
}

Table fines [note: 'Штрафи. Аудит змін'] {
  fine_id integer [pk, increment]
  loan_id integer
  member_id integer [not null]
  amount "numeric(10,2)" [not null]
  reason varchar(255) [not null]
  issued_at timestamptz [not null, default: `now()`]
  status fine_status [not null, default: 'unpaid']
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  Indexes {
    member_id [type: btree, name: "ix_fines_member_unpaid", note: 'BTREE WHERE (status = "unpaid"::fine_status)']
  }
}

Table additional_services [note: 'Додаткові послуги (друк, сканування, МБА...). Soft delete + аудит'] {
  service_id integer [pk, increment]
  code varchar(30) [not null, unique]
  name varchar(120) [not null]
  unit varchar(30) [not null]
  unit_price "numeric(10,2)" [not null]
  is_active boolean [not null, default: true]
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  is_deleted boolean [not null, default: false, note: 'Soft delete']
  deleted_at timestamptz [note: 'Soft delete: дата видалення']
  deleted_by integer [note: 'Soft delete: хто видалив']
}

Table service_orders [note: 'Замовлення додаткових послуг'] {
  order_id integer [pk, increment]
  member_id integer [not null]
  service_id integer [not null]
  branch_id integer [not null]
  quantity "numeric(8,2)" [not null]
  unit_price "numeric(10,2)" [not null]
  discount "numeric(5,2)" [not null, default: 0]
  total_price "numeric(12,2)" [default: `round(((quantity * unit_price) * ((1)`, note: 'GENERATED ALWAYS AS ... STORED']
  status order_status [not null, default: 'new']
  ordered_at timestamptz [not null, default: `now()`]
  handled_by integer
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  Indexes {
    (member_id, ordered_at) [type: btree, name: "ix_service_orders_member", note: 'BTREE']
  }
}

Table rooms [note: 'Приміщення для оренди'] {
  room_id integer [pk, increment]
  branch_id integer [not null]
  name varchar(80) [not null]
  capacity smallint [not null]
  hourly_rate "numeric(10,2)" [not null]
  has_projector boolean [not null, default: false]
}

Table room_bookings [note: 'Бронювання приміщень (EXCLUDE: без накладок у часі)'] {
  booking_id integer [pk, increment]
  room_id integer [not null]
  member_id integer [not null]
  period tstzrange [not null]
  purpose varchar(200)
  is_cancelled boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  Indexes {
    period [name: "ix_room_bookings_period", note: 'GIST']
  }
}

Table events [note: 'Заходи бібліотеки. Soft delete + аудит'] {
  event_id integer [pk, increment]
  branch_id integer [not null]
  room_id integer
  title varchar(200) [not null]
  description text
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  max_participants smallint [not null]
  ticket_price "numeric(10,2)" [not null, default: 0]
  organizer_id integer
  updated_at timestamptz [not null, default: `now()`, note: 'Дата останньої зміни (тригер)']
  updated_by integer [note: 'Користувач, що останнім змінив запис (тригер)']
  is_deleted boolean [not null, default: false, note: 'Soft delete']
  deleted_at timestamptz [note: 'Soft delete: дата видалення']
  deleted_by integer [note: 'Soft delete: хто видалив']
  Indexes {
    starts_at [type: btree, name: "ix_events_starts", note: 'BTREE WHERE (NOT is_deleted)']
  }
}

Table event_registrations [note: 'Реєстрації на заходи'] {
  registration_id integer [pk, increment]
  event_id integer [not null]
  member_id integer [not null]
  registered_at timestamptz [not null, default: `now()`]
  attended boolean
}

Table payments [note: 'Платежі (рівно одна ціль оплати)'] {
  payment_id integer [pk, increment]
  member_id integer [not null]
  amount "numeric(12,2)" [not null]
  method payment_method [not null]
  paid_at timestamptz [not null, default: `now()`]
  received_by integer
  fine_id integer
  order_id integer
  membership_id integer
  booking_id integer
  registration_id integer
  Indexes {
    (member_id, paid_at) [type: btree, name: "ix_payments_member", note: 'BTREE']
    paid_at [name: "ix_payments_paid_at_brin", note: 'BRIN']
  }
}

Table audit_log [note: 'Журнал змін (заповнюється тригерами)'] {
  audit_id bigint [pk, increment]
  table_name varchar(63) [not null]
  record_id integer [not null]
  operation character(1) [not null]
  old_data jsonb
  new_data jsonb
  changed_by integer
  changed_at timestamptz [not null, default: `now()`]
  Indexes {
    changed_at [name: "ix_audit_log_changed_at_brin", note: 'BRIN']
    new_data [name: "ix_audit_log_new_data", note: 'GIN']
    (table_name, record_id) [type: btree, name: "ix_audit_log_record", note: 'BTREE']
  }
}

TableGroup "Персонал і філії" {
  roles
  staff
  branches
}

TableGroup "Читачі та абонементи" {
  members
  membership_plans
  memberships
}

TableGroup "Каталог і фонд" {
  books
  authors
  publishers
  genres
  book_authors
  book_genres
  book_copies
  book_reviews
}

TableGroup "Обіг книг" {
  loans
  reservations
  fines
}

TableGroup "Додаткові послуги" {
  additional_services
  service_orders
  rooms
  room_bookings
  events
  event_registrations
}

TableGroup "Фінанси та аудит" {
  payments
  audit_log
}

Ref: additional_services.deleted_by > staff.staff_id
Ref: additional_services.updated_by > staff.staff_id
Ref: audit_log.changed_by > staff.staff_id
Ref: authors.deleted_by > staff.staff_id
Ref: book_authors.author_id > authors.author_id
Ref: book_authors.book_id > books.book_id [delete: cascade]
Ref: book_copies.book_id > books.book_id
Ref: book_copies.branch_id > branches.branch_id
Ref: book_copies.deleted_by > staff.staff_id
Ref: book_copies.updated_by > staff.staff_id
Ref: book_genres.book_id > books.book_id [delete: cascade]
Ref: book_genres.genre_id > genres.genre_id
Ref: book_reviews.book_id > books.book_id
Ref: book_reviews.deleted_by > staff.staff_id
Ref: book_reviews.member_id > members.member_id
Ref: books.created_by > staff.staff_id
Ref: books.deleted_by > staff.staff_id
Ref: books.publisher_id > publishers.publisher_id
Ref: books.updated_by > staff.staff_id
Ref: event_registrations.event_id > events.event_id
Ref: event_registrations.member_id > members.member_id
Ref: events.branch_id > branches.branch_id
Ref: events.deleted_by > staff.staff_id
Ref: events.organizer_id > staff.staff_id
Ref: events.room_id > rooms.room_id
Ref: events.updated_by > staff.staff_id
Ref: fines.loan_id > loans.loan_id
Ref: fines.member_id > members.member_id
Ref: fines.updated_by > staff.staff_id
Ref: genres.parent_genre_id > genres.genre_id
Ref: loans.copy_id > book_copies.copy_id
Ref: loans.issued_by > staff.staff_id
Ref: loans.member_id > members.member_id
Ref: loans.received_by > staff.staff_id
Ref: loans.updated_by > staff.staff_id
Ref: members.created_by > staff.staff_id
Ref: members.deleted_by > staff.staff_id
Ref: members.updated_by > staff.staff_id
Ref: membership_plans.updated_by > staff.staff_id
Ref: memberships.member_id > members.member_id
Ref: memberships.plan_id > membership_plans.plan_id
Ref: payments.booking_id > room_bookings.booking_id
Ref: payments.fine_id > fines.fine_id
Ref: payments.member_id > members.member_id
Ref: payments.membership_id > memberships.membership_id
Ref: payments.order_id > service_orders.order_id
Ref: payments.received_by > staff.staff_id
Ref: payments.registration_id > event_registrations.registration_id
Ref: reservations.book_id > books.book_id
Ref: reservations.branch_id > branches.branch_id
Ref: reservations.member_id > members.member_id
Ref: room_bookings.member_id > members.member_id
Ref: room_bookings.room_id > rooms.room_id
Ref: room_bookings.updated_by > staff.staff_id
Ref: rooms.branch_id > branches.branch_id
Ref: service_orders.branch_id > branches.branch_id
Ref: service_orders.handled_by > staff.staff_id
Ref: service_orders.member_id > members.member_id
Ref: service_orders.service_id > additional_services.service_id
Ref: service_orders.updated_by > staff.staff_id
Ref: staff.branch_id > branches.branch_id
Ref: staff.role_id > roles.role_id
